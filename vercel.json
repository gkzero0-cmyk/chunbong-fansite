{
  "cleanUrls": false,
  "git": {
    "deploymentEnabled": {
      "data/soop-telemetry": false,
      "internal-*": false,
      "ci-*": false,
      "docs-*": false,
      "feat/*": false,
      "fix/*": false,
      "chore/*": false,
      "ci/*": false,
      "refactor/*": false,
      "test/*": false,
      "hotfix/*": false,
      "main": true,
      "internal/*": false,
      "feature/*": false,
      "perf/*": false
    }
  },
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node .github/scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/timeline.html",
      "destination": "/history.html",
      "permanent": true
    },
    {
      "source": "/timeline",
      "destination": "/history.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/contents/:id",
      "destination": "/chunbong-contents.html?id=:id"
    },
    {
      "source": "/api/operator/github/start",
      "destination": "/api/content?type=operator-github-start"
    },
    {
      "source": "/api/operator/github/callback",
      "destination": "/api/content?type=operator-github-callback"
    }
  ]
}
